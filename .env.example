# ---------------------------------------------------------------------------
# GoldenHour - server environment (copy to .env at the project root)
# ---------------------------------------------------------------------------
# API port (the Vite dev server proxies /api to this port)
PORT=4000

# Allowed browser origin for direct API calls.
# In development the browser talks to Vite (port 3000) which proxies /api,
# so this is only needed when you call the API from another origin.
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma and the health probe.
# The bundled local cluster (npm run db:setup) accepts this default.
DATABASE_URL=postgresql://goldenhour:goldenhour@localhost:5432/goldenhour?schema=public

# Secret used to sign the 8-hour JWT session cookie.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret

# Session lifetime in hours (Gate 1 requires 8) and cookie name.
SESSION_HOURS=8
SESSION_COOKIE_NAME=gh_session

# Node environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Campaign notification providers (all optional)
# ---------------------------------------------------------------------------
# The in-app notification feed always works. A channel with no provider is
# reported as SKIPPED in the campaign delivery report, never silently dropped.

# Email via Resend (https://resend.com). NOTIFY_EMAIL_FROM must be a verified
# sender, e.g. "GoldenHour <camps@yourdomain.org>".
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# SMS via Twilio. The patient's 10-digit contact is prefixed with the country
# code below unless it already starts with "+".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_COUNTRY_CODE=+91

# Browser Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these, the server generates a development pair per process, so
# existing browser subscriptions stop working after a restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.org
